 /* Get next character. */
 static LJ_AINLINE LexChar lex_next(LexState *ls)
 {
+  if (ls->haspeek) {
+    ls->haspeek = 0;
+    return (ls->c = ls->peekc);
+  }
   return (ls->c = ls->p < ls->pe ? (LexChar)(uint8_t)*ls->p++ : lex_more(ls));
 }
 
+/* Peek only at an operator candidate; strings and comments remain raw bytes. */
+static LJ_AINLINE int lex_isdivision(LexState *ls)
+{
+  if (ls->c != 0xc3) return 0;
+  if (!ls->haspeek) {
+    ls->peekc = ls->p < ls->pe ? (LexChar)(uint8_t)*ls->p++ : lex_more(ls);
+    ls->haspeek = 1;
+  }
+  return ls->peekc == 0xb7;
+}
